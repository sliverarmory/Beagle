# Track Beagle and its pinned public build inputs.
# Private data, compatibility validation tooling, and outputs stay local.
/*
!/.gitignore
!/.gitattributes
!/Cargo.toml
!/Cargo.lock
!/rust-toolchain.toml
!/build.rs
!/build-support/
/build-support/*
!/build-support/*.rs
!/LICENSE
!/THIRD_PARTY_NOTICES.md
!/README.md

!/docs/
/docs/*
!/docs/helper-stdio.md

!/data/
/data/*
!/data/queries.json
!/data/ad-attack-paths.json

!/vendor/
/vendor/*
!/vendor/graphqlite-source.tar.gz
!/vendor/graphqlite-source.json
!/vendor/build-inputs.json

!/.github/
/.github/*
!/.github/workflows/
/.github/workflows/*
!/.github/workflows/build.yml
!/.github/workflows/release.yml
!/.github/actions/
!/.github/build/
!/.github/scripts/

!/assets/
/assets/*
!/assets/beagle-logo.png

# Keep planning notes local even if broader documentation is added later.
ROADMAP.md

!/licenses/
/licenses/*
!/licenses/dawgs-MIT.txt
!/licenses/BloodHound-Query-Library-MIT.txt
!/licenses/GraphQLite-MIT.txt
!/licenses/PCRE2-LICENSE.txt
!/licenses/SQLite-public-domain.txt

!/src/
/src/**
!/src/**/
!/src/**/*.rs

!/tests/
/tests/*
!/tests/analysis.rs
!/tests/asset_groups.rs
!/tests/asset_group_rules.rs
!/tests/import_history_retention.rs
!/tests/cli.rs
!/tests/helper_stdio.rs
!/tests/composition.rs
!/tests/composition_ntlm.rs
!/tests/ingest.rs
!/tests/library.rs
!/tests/store.rs
!/tests/backend_build.rs
!/tests/windows_build.rs
!/tests/library-consumer/
/tests/library-consumer/*
!/tests/library-consumer/Cargo.toml
!/tests/library-consumer/Cargo.lock
!/tests/library-consumer/src/
/tests/library-consumer/src/*
!/tests/library-consumer/src/main.rs

*.db
*.db-shm
*.db-wal
__pycache__/
.env
