# Track only Beagle's Rust source, Cargo files, tests, and license notices.
# Data, compatibility tooling, vendored code, documentation, and outputs stay local.
/*
!/.gitignore
!/Cargo.toml
!/Cargo.lock
!/build.rs
!/LICENSE
!/THIRD_PARTY_NOTICES.md

!/licenses/
/licenses/*
!/licenses/dawgs-MIT.txt

!/src/
/src/**
!/src/**/
!/src/**/*.rs

!/tests/
/tests/*
!/tests/analysis.rs
!/tests/asset_groups.rs
!/tests/cli.rs
!/tests/composition.rs
!/tests/composition_ntlm.rs
!/tests/ingest.rs
!/tests/library.rs
!/tests/store.rs
!/tests/library-consumer/
/tests/library-consumer/*
!/tests/library-consumer/Cargo.toml
!/tests/library-consumer/Cargo.lock
!/tests/library-consumer/src/
/tests/library-consumer/src/*
!/tests/library-consumer/src/main.rs

*.db
*.db-shm
*.db-wal
__pycache__/
.env
